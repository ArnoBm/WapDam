[Unit]
Description=WapDam - WhatsApp Automation Outreach Engine
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/path/to/WhatsApp/Automation
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=10
Environment=NODE_ENV=production PORT=3005

[Install]
WantedBy=multi-user.target
